// y[s, j] += b[j] over a [rows, cols] row-major matrix (a Linear's bias in the transposed layout).
layout(local_size_x = 256) in;
layout(binding = 0) buffer Y { float y[]; };
layout(binding = 1) readonly buffer B { float b[]; };
layout(push_constant) uniform PC { uint rows; uint cols; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.rows * pc.cols) return;
    y[i] += b[i % pc.cols];
}
