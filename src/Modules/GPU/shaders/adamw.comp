#version 450
// AdamW update with device-side hyperparams (HP) and global grad-norm clip factor (clip[0]).
// HP layout: [0]=lr [1]=b1 [2]=b2 [3]=eps [4]=wd [5]=invBc1 [6]=invBc2
layout(local_size_x = 256) in;
layout(binding = 0) buffer P { float p[]; };
layout(binding = 1) readonly buffer G { float g[]; };
layout(binding = 2) buffer M { float m[]; };
layout(binding = 3) buffer V { float v[]; };
layout(binding = 4) readonly buffer CLIP { float clip[]; };
layout(binding = 5) readonly buffer HP { float hp[]; };
layout(push_constant) uniform PC { uint n; } pc;

void main(){
    uint i = gl_GlobalInvocationID.x;
    if(i >= pc.n) return;
    float s = clip[0];
    if(!(s == s)) s = 0.0;            // NaN clip -> freeze this step
    float gg = g[i] * s;
    if(!(gg == gg) || abs(gg) > 1.0e30) return;
    float b1 = hp[1], b2 = hp[2];
    float mi = b1 * m[i] + (1.0 - b1) * gg;
    float vi = b2 * v[i] + (1.0 - b2) * gg * gg;
    m[i] = mi;
    v[i] = vi;
    float mh = mi * hp[5];
    float vh = vi * hp[6];
    float upd = mh / (sqrt(vh) + hp[3]);
    p[i] = p[i] - hp[0] * (upd + hp[4] * p[i]);
}
