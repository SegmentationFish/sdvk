// generic strided copy: dst[sum(coord*ostr)] (op)= scale*src[sum(coord*sstr)]
// coordinates decompose over dims d0..d3 (row-major)
layout(local_size_x = 256) in;
layout(binding = 0) buffer Dst { float d[]; };
layout(binding = 1) readonly buffer Src { float s[]; };
layout(push_constant) uniform PC {
    uint n;
    uint d0, d1, d2, d3;
    uint os0, os1, os2, os3;
    uint ss0, ss1, ss2, ss3;
    uint mode;
    float scale;
} pc;

void main(){
    uint i = gl_GlobalInvocationID.x;
    if(i >= pc.n) return;
    uint c0 = i % pc.d0; uint t = i / pc.d0;
    uint c1 = t % pc.d1; t /= pc.d1;
    uint c2 = t % pc.d2; t /= pc.d2;
    uint c3 = t;
    uint so = pc.ss0*c0 + pc.ss1*c1 + pc.ss2*c2 + pc.ss3*c3;
    uint dof = pc.os0*c0 + pc.os1*c1 + pc.os2*c2 + pc.os3*c3;
    float v = pc.scale * s[so];
    if(pc.mode == 0u) d[dof] = v;
    else d[dof] += v;
}
