// y = x, except where the mask is zero, where y becomes -1e30 so the next softmax drops it
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 1) readonly buffer M { float m[]; };
layout(binding = 2) writeonly buffer Y { float y[]; };
layout(push_constant) uniform PC { uint rows; uint cols; } pc;

void main(){
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.rows * pc.cols) return;
    y[i] = (m[i % (pc.rows * pc.cols)] != 0.0) ? x[i] : -1.0e30;
}
