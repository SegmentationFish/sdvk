// rowwise RMSNorm: out = x * rsqrt(mean(x^2)+eps) * w
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 1) readonly buffer W { float w[]; };
layout(binding = 2) writeonly buffer Y { float y[]; };
layout(push_constant) uniform PC { uint rows; uint d; float eps; uint pad; } pc;

shared float red[256];

void main(){
    uint tid = gl_LocalInvocationID.x;
    uint r = gl_WorkGroupID.x;
    float s = 0.0;
    for(uint j=tid;j<pc.d;j+=256){ float v=x[r*pc.d+j]; s += v*v; }
    red[tid] = s;
    barrier();
    for(uint step=128;step>0;step>>=1){
        if(tid < step) red[tid] += red[tid+step];
        barrier();
    }
    float inv = 1.0 / sqrt(red[0] / float(pc.d) + pc.eps);
    for(uint j=tid;j<pc.d;j+=256) y[r*pc.d+j] = x[r*pc.d+j] * inv * w[j];
}
