#version 450
// gMul same-shape backward: ga += go*y; gb += go*x
layout(local_size_x = 256) in;
layout(binding = 0) buffer GA { float ga[]; };
layout(binding = 1) buffer GB { float gb[]; };
layout(binding = 2) readonly buffer GO { float go[]; };
layout(binding = 3) readonly buffer X { float x[]; };
layout(binding = 4) readonly buffer Y { float y[]; };
layout(push_constant) uniform PC { uint n; } pc;

void main(){
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float g = go[i];
    ga[i] += g * y[i];
    gb[i] += g * x[i];
}
