// out[b,d] = (1/T) * sum_t x[b,t,d]   (sequence mean-pool, spec §7.2 / §10.2)
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 1) writeonly buffer OUT { float o[]; };
layout(push_constant) uniform PC { uint B; uint T; uint d; } pc;

void main(){
    uint i = gl_GlobalInvocationID.x;
    if(i >= pc.B * pc.d) return;
    uint b = i / pc.d;
    uint j = i % pc.d;
    float s = 0.0;
    for(uint t=0;t<pc.T;t++) s += x[(b*pc.T+t)*pc.d + j];
    o[i] = s / float(pc.T);
}
