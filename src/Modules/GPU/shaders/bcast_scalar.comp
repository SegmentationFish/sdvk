// gx[i] += scalar[0] * s
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer S { float scalar[]; };
layout(binding = 1) buffer GX { float gx[]; };
layout(push_constant) uniform PC { uint n; float s; } pc;

void main(){
    uint i = gl_GlobalInvocationID.x;
    if(i >= pc.n) return;
    gx[i] += scalar[0] * pc.s;
}
