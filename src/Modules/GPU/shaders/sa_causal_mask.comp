// Causal mask for batched prefill: scores[h, i, j] = -inf when j > (i + offset).
layout(local_size_x = 256) in;
layout(binding = 0) buffer S { float s[]; };
layout(push_constant) uniform PC { uint heads; uint rows; uint cols; uint offset; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint total = pc.heads * pc.rows * pc.cols;
    if (i >= total) return;
    uint col = i % pc.cols;
    uint row = (i / pc.cols) % pc.rows;
    if (col > row + pc.offset) s[i] = -3.0e38;
}
