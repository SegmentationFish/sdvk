// Table-driven grad-norm partial reduction: one workgroup per (param, block) entry,
// all parameters batched into a single dispatch.
// tbl[wg] = (gradOffsetFloats, n, localWg, partialIndex)
// Same strided coverage as the legacy per-param norm_sq kernel (bit-identical sums).
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer G { float g[]; };
layout(binding = 1) writeonly buffer PART { float part[]; };
layout(binding = 2) readonly buffer TBL { uvec4 tbl[]; };

shared float red[256];

void main(){
    uint tid = gl_LocalInvocationID.x;
    uint wg = gl_WorkGroupID.x;
    uvec4 e = tbl[wg];
    float s = 0.0;
    for (uint i = e.z * 16384u + tid; i < e.y; i += 16384u){
        float v = g[e.x + i];
        s += v * v;
    }
    red[tid] = s;
    barrier();
    for (uint step = 128; step > 0; step >>= 1){
        if (tid < step) red[tid] += red[tid + step];
        barrier();
    }
    if (tid == 0) part[e.w] = red[0];
}
