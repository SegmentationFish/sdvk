// partial[wg] = sum of squares of g[] (per-workgroup partials, summed later)
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer G { float g[]; };
layout(binding = 1) writeonly buffer PART { float part[]; };
layout(push_constant) uniform PC { uint n; } pc;

shared float red[256];

void main(){
    uint tid = gl_LocalInvocationID.x;
    uint wg = gl_WorkGroupID.x;
    float s = 0.0;
    for(uint i=wg*256u*64u + tid; i<pc.n; i+=256u*64u){
        float v = g[i];
        s += v*v;
    }
    red[tid] = s;
    barrier();
    for(uint step=128;step>0;step>>=1){
        if(tid < step) red[tid] += red[tid+step];
        barrier();
    }
    if(tid==0) part[wg] = red[0];
}
