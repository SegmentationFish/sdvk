// out[r,j] = sum_g (Y[g,r,j] + b2[g,j]) * w[g,r]
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer Y { float y[]; };
layout(binding = 1) readonly buffer B2 { float b2[]; };
layout(binding = 2) readonly buffer W { float w[]; };
layout(binding = 3) writeonly buffer OUT { float outv[]; };
layout(push_constant) uniform PC { uint rows; uint d; uint g; } pc;

void main(){
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.rows * pc.d) return;
    uint j = i % pc.d;
    uint r = i / pc.d;
    float acc = 0.0;
    for (uint g = 0; g < pc.g; g++){
        float v = y[(g * pc.rows + r) * pc.d + j] + b2[g * pc.d + j];
        acc += v * w[r * pc.g + g];
    }
    outv[i] = acc;
}
