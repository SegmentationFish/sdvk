// nearest 2x upsample, NCHW (batch=1)
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer IN { float inx[]; };
layout(binding = 1) writeonly buffer OUT { float outv[]; };
layout(push_constant) uniform PC { uint C; uint H; uint W; } pc;

void main(){
    uint W2 = pc.W * 2u, H2 = pc.H * 2u;
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.C * W2 * H2) return;
    uint c = i / (W2 * H2);
    uint r = i - c * (W2 * H2);
    uint oh = r / W2;
    uint ow = r - oh * W2;
    outv[i] = inx[(c * pc.H + oh / 2u) * pc.W + ow / 2u];
}
