// rowwise softmax over `cols`, one workgroup per row
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 1) writeonly buffer Y { float y[]; };
layout(push_constant) uniform PC { uint rows; uint cols; } pc;

shared float red[256];

void main(){
    uint tid = gl_LocalInvocationID.x;
    uint r = gl_WorkGroupID.x;
    const float NEG = -3.0e38;
    float mx = NEG;
    for(uint j=tid;j<pc.cols;j+=256) mx = max(mx, x[r*pc.cols+j]);
    red[tid] = mx;
    barrier();
    for(uint step=128;step>0;step>>=1){
        if(tid < step) red[tid] = max(red[tid], red[tid+step]);
        barrier();
    }
    float m = red[0];
    float s = 0.0;
    for(uint j=tid;j<pc.cols;j+=256) s += exp(x[r*pc.cols+j] - m);
    red[tid] = s;
    barrier();
    for(uint step=128;step>0;step>>=1){
        if(tid < step) red[tid] += red[tid+step];
        barrier();
    }
    float ir = 1.0 / red[0];
    for(uint j=tid;j<pc.cols;j+=256) y[r*pc.cols+j] = exp(x[r*pc.cols+j] - m) * ir;
}
