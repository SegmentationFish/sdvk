#version 450
// elementwise activation: mode 0 gelu, mode 1 sigmoid
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 1) writeonly buffer Y { float y[]; };
layout(push_constant) uniform PC { uint n; uint mode; } pc;

void main(){
    uint i = gl_GlobalInvocationID.x;
    if(i >= pc.n) return;
    float v = x[i];
    if(pc.mode == 0u){
        float t = 0.7978845608028654 * (v + 0.044715*v*v*v);
        // 稳定 tanh：驱动内建 tanh 在 |t|>~44 时 exp 溢出成 inf/inf=NaN
        float e = exp(-2.0 * abs(t));
        float th = (1.0 - e) / (1.0 + e);
        if(t < 0.0) th = -th;
        y[i] = 0.5 * v * (1.0 + th);
    }else if(pc.mode == 1u){
        y[i] = 1.0 / (1.0 + exp(-v));
    }else if(pc.mode == 2u){
        y[i] = v / (1.0 + exp(-v));
    }else if(pc.mode == 3u){
        y[i] = v / (1.0 + exp(-1.702 * v));
    }else{
        // exact erf gelu: 0.5*x*(1+erf(x/sqrt(2))), Abramowitz & Stegun 7.1.26 (|eps|<=1.5e-7)
        float xs = v * 0.70710678118654752440;
        float ax = abs(xs);
        float t = 1.0 / (1.0 + 0.3275911 * ax);
        float e = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp(-ax * ax);
        float erf = xs >= 0.0 ? e : -e;
        y[i] = 0.5 * v * (1.0 + erf);
    }
}
