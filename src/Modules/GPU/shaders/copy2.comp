// dual-destination gradient routing: a (op)= s; b (op)= s (mode 1 accumulates)
layout(local_size_x = 256) in;
layout(binding = 0) buffer A { float a[]; };
layout(binding = 1) buffer B { float b[]; };
layout(binding = 2) readonly buffer S { float s[]; };
layout(push_constant) uniform PC { uint n; uint mode; } pc;

void main(){
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float v = s[i];
    if (pc.mode == 0u){ a[i] = v; b[i] = v; }
    else { a[i] += v; b[i] += v; }
}
