// dst[i] += sum_g tmp[g,i]
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer TMP { float tmp[]; };
layout(binding = 1) buffer DST { float dst[]; };
layout(push_constant) uniform PC { uint n; uint g; } pc;

void main(){
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float s = 0.0;
    for (uint g = 0; g < pc.g; g++) s += tmp[g * pc.n + i];
    dst[i] += s;
}
