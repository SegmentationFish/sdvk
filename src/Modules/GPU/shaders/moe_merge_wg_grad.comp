#version 450
// grid = g*d (b2 列和) + g*rows (w 行点积)
//   idx < g*d:    db2[g,j] += sum_r dY[g,r,j]
//   else:         dw[g,r]  += sum_j dOut[r,j]*Y[g,r,j]
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer DOUT { float dout[]; };
layout(binding = 1) readonly buffer Y { float y[]; };
layout(binding = 2) readonly buffer DY { float dy[]; };
layout(binding = 3) buffer DB2 { float db2[]; };
layout(binding = 4) buffer DW { float dw[]; };
layout(push_constant) uniform PC { uint rows; uint d; uint g; } pc;

shared float red[256];

void main(){
    uint idx = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint ndb = pc.g * pc.d;
    float s = 0.0;
    if (idx < ndb){
        uint g = idx / pc.d;
        uint j = idx % pc.d;
        for (uint r = tid; r < pc.rows; r += 256)
            s += dy[(g * pc.rows + r) * pc.d + j];
        red[tid] = s;
        barrier();
        for (uint step = 128; step > 0; step >>= 1){
            if (tid < step) red[tid] += red[tid + step];
            barrier();
        }
        if (tid == 0) db2[idx] += red[0];
    } else {
        uint k = idx - ndb;
        uint g = k / pc.rows;
        uint r = k % pc.rows;
        for (uint j = tid; j < pc.d; j += 256)
            s += dout[r * pc.d + j] * y[(g * pc.rows + r) * pc.d + j];
        red[tid] = s;
        barrier();
        for (uint step = 128; step > 0; step >>= 1){
            if (tid < step) red[tid] += red[tid + step];
            barrier();
        }
        if (tid == 0) dw[r * pc.g + g] += red[0];
    }
}
