// gx[i] += sum_b go[b*s*d + i]
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer GO { float go[]; };
layout(binding = 1) buffer GX { float gx[]; };
layout(push_constant) uniform PC { uint batch; uint s; uint d; } pc;

void main(){
    uint i = gl_GlobalInvocationID.x;
    uint n = pc.s * pc.d;
    if(i >= n) return;
    float acc = 0.0;
    for(uint b=0;b<pc.batch;b++) acc += go[b*n + i];
    gx[i] += acc;
}
