// gprobs[r,g] += go * (groups/rows) * q[g]
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer GO { float go[]; };
layout(binding = 1) readonly buffer COUNTS { uint cnt[]; };
layout(binding = 2) buffer GPROBS { float gp[]; };
layout(push_constant) uniform PC { uint rows; uint groups; } pc;

void main(){
    uint i = gl_GlobalInvocationID.x;
    if(i >= pc.rows * pc.groups) return;
    uint g = i % pc.groups;
    float tot = 0.0;
    for(uint j=0;j<pc.groups;j++) tot += float(cnt[j]);
    float q = float(cnt[g]) / max(tot, 1.0);
    float coef = float(pc.groups) / float(pc.rows);
    gp[i] += go[0] * coef * q;
}
