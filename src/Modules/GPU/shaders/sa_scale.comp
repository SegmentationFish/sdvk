// y = x * s (elementwise scalar scale, used for the 1/sqrt(head_dim) attention factor).
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 1) writeonly buffer Y { float y[]; };
layout(push_constant) uniform PC { uint n; float s; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    y[i] = x[i] * pc.s;
}
