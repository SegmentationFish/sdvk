// Adafactor factored second-moment statistics.
// mode 0: one workgroup per ROW r: sum_j g[r,j]^2 -> R[r] = b2*R[r] + (1-b2)*(sum/cols)
// mode 1: one workgroup per COL c: sum_i g[i,c]^2 -> C[c] = b2*C[c] + (1-b2)*(sum/rows)
// mode 2: single workgroup: outv[0] = mean(R[0..rows))
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer G { float g[]; };
layout(binding = 1) buffer S { float st[]; };
layout(binding = 2) writeonly buffer OUT { float outv[]; };
layout(binding = 3) readonly buffer HP { float hp[]; };
layout(push_constant) uniform PC { uint rows; uint cols; uint mode; } pc;

shared float red[256];

void main(){
    uint tid = gl_LocalInvocationID.x;
    if (pc.mode == 2u){
        float s = 0.0;
        for (uint i = tid; i < pc.rows; i += 256) s += st[i];
        red[tid] = s;
        barrier();
        for (uint step = 128; step > 0; step >>= 1){
            if (tid < step) red[tid] += red[tid + step];
            barrier();
        }
        if (tid == 0) outv[0] = red[0] / float(max(pc.rows, 1u));
        return;
    }
    uint k = gl_WorkGroupID.x;
    float s = 0.0;
    if (pc.mode == 0u){
        for (uint j = tid; j < pc.cols; j += 256){
            float v = g[k * pc.cols + j];
            s += v * v;
        }
        red[tid] = s;
        barrier();
        for (uint step = 128; step > 0; step >>= 1){
            if (tid < step) red[tid] += red[tid + step];
            barrier();
        }
        if (tid == 0)
            st[k] = hp[7] * st[k] + (1.0 - hp[7]) * (red[0] / float(max(pc.cols, 1u)));
    } else {
        for (uint i = tid; i < pc.rows; i += 256){
            float v = g[i * pc.cols + k];
            s += v * v;
        }
        red[tid] = s;
        barrier();
        for (uint step = 128; step > 0; step >>= 1){
            if (tid < step) red[tid] += red[tid + step];
            barrier();
        }
        if (tid == 0)
            st[k] = hp[7] * st[k] + (1.0 - hp[7]) * (red[0] / float(max(pc.rows, 1u)));
    }
}
