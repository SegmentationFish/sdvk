#version 450
// rope backward: gx += R^T * go (accumulate)
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer GO { float go[]; };
layout(binding = 1) readonly buffer POS { int pos[]; };
layout(binding = 2) buffer GX { float gx[]; };
layout(push_constant) uniform PC {
    uint batch; uint seq; uint hd; uint inverse; float base; uint pad;
} pc;

void main(){
    uint i = gl_GlobalInvocationID.x;
    uint total = pc.batch * pc.seq * pc.hd;
    if(i >= total) return;
    uint hi = i % pc.hd;
    uint t = (i / pc.hd) % pc.seq;
    uint b = i / (pc.hd * pc.seq);
    float inv = 1.0 / pow(pc.base, float(hi) / float(pc.hd));
    float ang = float(pos[t]) * inv * (pc.inverse == 1u ? -1.0 : 1.0);
    float c = cos(ang);
    float s = sin(ang);
    uint base_i = (b * pc.seq + t) * (2u * pc.hd);
    float g1 = go[base_i + hi];
    float g2 = go[base_i + hi + pc.hd];
    gx[base_i + hi] += g1 * c + g2 * s;
    gx[base_i + hi + pc.hd] += -g1 * s + g2 * c;
}
