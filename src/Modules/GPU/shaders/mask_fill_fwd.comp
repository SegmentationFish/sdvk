// out[i] = mask[i % period] != 0 ? x[i] : -INF
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 1) readonly buffer MASK { uint mask[]; };
layout(binding = 2) writeonly buffer OUT { float o[]; };
layout(push_constant) uniform PC { uint n; uint period; } pc;

void main(){
    uint i = gl_GlobalInvocationID.x;
    if(i >= pc.n) return;
    bool keep = mask[i % pc.period] != 0u;
    o[i] = keep ? x[i] : (-3.0e38);
}
