// rowLoss[r] = -log softmax(logits[r])[target[r]] ; one workgroup per row
// mask[r]==0 rows contribute zero loss (used for SFT answer-only masking)
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer LOGITS { float lg[]; };
layout(binding = 1) readonly buffer TGT { uint tgt[]; };
layout(binding = 2) writeonly buffer ROWLOSS { float rl[]; };
layout(binding = 3) readonly buffer MASK { uint msk[]; };
layout(push_constant) uniform PC { uint rows; uint v; } pc;

shared float red[256];

void main(){
    uint tid = gl_LocalInvocationID.x;
    uint r = gl_WorkGroupID.x;
    if(msk[r] == 0u){ if(tid == 0) rl[r] = 0.0; return; }
    const float NEG = -3.0e38;
    float mx = NEG;
    for(uint j=tid;j<pc.v;j+=256) mx = max(mx, lg[r*pc.v+j]);
    red[tid] = mx;
    barrier();
    for(uint step=128;step>0;step>>=1){
        if(tid < step) red[tid] = max(red[tid], red[tid+step]);
        barrier();
    }
    float m = red[0];
    float s = 0.0;
    for(uint j=tid;j<pc.v;j+=256) s += exp(lg[r*pc.v+j] - m);
    red[tid] = s;
    barrier();
    for(uint step=128;step>0;step>>=1){
        if(tid < step) red[tid] += red[tid+step];
        barrier();
    }
    if(tid==0){
        float t = lg[r*pc.v + tgt[r]];
        rl[r] = -(t - m) + log(red[0]);
    }
}
