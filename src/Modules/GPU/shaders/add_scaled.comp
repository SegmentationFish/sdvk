// c[i] = a[i] + s*b[i] in one pass. IP-Adapter adds its scaled attention output to the text
// attention output before the output projection; doing it here avoids a temporary and a
// separate scale pass per cross-attention layer.
layout(local_size_x = 256) in;
layout(binding = 0) writeonly buffer C { float c[]; };
layout(binding = 1) readonly buffer A { float a[]; };
layout(binding = 2) readonly buffer B { float b[]; };
layout(push_constant) uniform PC { uint n; float s; } pc;

void main(){
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    c[i] = a[i] + pc.s * b[i];
}
