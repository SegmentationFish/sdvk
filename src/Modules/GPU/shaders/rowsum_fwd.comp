// out[r] = sum_j x[r,j]  (one workgroup per row)
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 1) writeonly buffer OUT { float outv[]; };
layout(push_constant) uniform PC { uint rows; uint d; } pc;

shared float red[256];

void main(){
    uint tid = gl_LocalInvocationID.x;
    uint r = gl_WorkGroupID.x;
    float s = 0.0;
    for(uint j=tid;j<pc.d;j+=256) s += x[r*pc.d+j];
    red[tid] = s;
    barrier();
    for(uint step=128;step>0;step>>=1){
        if(tid < step) red[tid] += red[tid+step];
        barrier();
    }
    if(tid==0) outv[r] = red[0];
}
