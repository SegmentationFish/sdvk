// rowwise softmax backward: gx += p * (go - dot(p,go))
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer P { float p[]; };
layout(binding = 1) readonly buffer GO { float go[]; };
layout(binding = 2) buffer GX { float gx[]; };
layout(push_constant) uniform PC { uint rows; uint cols; } pc;

shared float red[256];

void main(){
    uint tid = gl_LocalInvocationID.x;
    uint r = gl_WorkGroupID.x;
    float s = 0.0;
    for(uint j=tid;j<pc.cols;j+=256) s += p[r*pc.cols+j] * go[r*pc.cols+j];
    red[tid] = s;
    barrier();
    for(uint step=128;step>0;step>>=1){
        if(tid < step) red[tid] += red[tid+step];
        barrier();
    }
    float dot = red[0];
    for(uint j=tid;j<pc.cols;j+=256){
        float pv = p[r*pc.cols+j];
        gx[r*pc.cols+j] += pv * (go[r*pc.cols+j] - dot);
    }
}
