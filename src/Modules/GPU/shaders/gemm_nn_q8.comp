// C[M,N] = A[M,K] * B[K,N] ; A = Q8_0 payload (uint32 packed int8, 4/word) + fp32 scales
// (one per 32 elements), B fp32 row-major. Batched on z.
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0) readonly buffer Aq { uint aq[]; };
layout(binding = 1) readonly buffer B { float b[]; };
layout(binding = 2) writeonly buffer C { float c[]; };
layout(binding = 3) readonly buffer S { float s[]; };
layout(push_constant) uniform PC { uint M; uint N; uint K; uint mode;
                                  uint sA; uint sB; uint sC; uint batch;
                                  uint lda; uint ldb; uint ldc; uint pad; } pc;

const uint BM = 64, BN = 64, BK = 16, TM = 4, TN = 4;
shared float As[BM][BK + 1];
shared float Bs[BK][BN + 1];

float deqA(uint fl){
    uint w = aq[fl >> 2];
    int v = int((w >> ((fl & 3u) * 8u)) & 0xFFu);
    if (v > 127) v -= 256;
    return float(v) * s[fl >> 5];
}

void main(){
    uint tx = gl_LocalInvocationID.x;
    uint ty = gl_LocalInvocationID.y;
    uint by = gl_WorkGroupID.y;
    uint bx = gl_WorkGroupID.x;
    uint zo = gl_WorkGroupID.z;
    uint ao = zo * pc.sA;
    uint bo = zo * pc.sB;
    uint co = zo * pc.sC;
    uint lda = pc.lda == 0u ? pc.K : pc.lda;
    uint ldb = pc.ldb == 0u ? pc.N : pc.ldb;
    uint ldc = pc.ldc == 0u ? pc.N : pc.ldc;

    float acc[TM][TN];
    for(uint i=0;i<TM;i++)
        for(uint j=0;j<TN;j++) acc[i][j]=0.0;

    uint nTiles = (pc.K + BK - 1) / BK;
    for(uint t=0;t<nTiles;t++){
        uint kBase = t * BK;
        for(uint l=0;l<4;l++){
            uint e = l*256 + ty*16 + tx;
            uint r = e / BK;
            uint c = e % BK;
            uint gr = by*BM + r;
            uint gc = kBase + c;
            As[r][c] = (gr < pc.M && gc < pc.K) ? deqA(ao + gr*lda + gc) : 0.0;
        }
        for(uint l=0;l<4;l++){
            uint e = l*256 + ty*16 + tx;
            uint r = e / BN;
            uint c = e % BN;
            uint gr = kBase + r;
            uint gc = bx*BN + c;
            Bs[r][c] = (gr < pc.K && gc < pc.N) ? b[bo + gr*ldb + gc] : 0.0;
        }
        barrier();
        for(uint k=0;k<BK;k++){
            float av[TM];
            float bv[TN];
            for(uint i=0;i<TM;i++) av[i]=As[ty*TM+i][k];
            for(uint j=0;j<TN;j++) bv[j]=Bs[k][tx*TN+j];
            for(uint i=0;i<TM;i++)
                for(uint j=0;j<TN;j++) acc[i][j]+=av[i]*bv[j];
        }
        barrier();
    }
    for(uint i=0;i<TM;i++)
        for(uint j=0;j<TN;j++){
            uint gr = by*BM + ty*TM + i;
            uint gc = bx*BN + tx*TN + j;
            if(gr < pc.M && gc < pc.N){
                if(pc.mode == 0u) c[co + gr*ldc + gc] = acc[i][j];
                else c[co + gr*ldc + gc] += acc[i][j];
            }
        }
}
