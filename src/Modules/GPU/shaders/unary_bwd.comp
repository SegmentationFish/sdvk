// gx[i] += go[i] * d(activation)/dx, using x (mode 0 gelu, 1 sigmoid)
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 1) readonly buffer GO { float go[]; };
layout(binding = 2) buffer GX { float gx[]; };
layout(push_constant) uniform PC { uint n; uint mode; } pc;

void main(){
    uint i = gl_GlobalInvocationID.x;
    if(i >= pc.n) return;
    float v = x[i];
    float d;
    if(pc.mode == 0u){
        float k = 0.7978845608028654;
        float t = k * (v + 0.044715*v*v*v);
        float th = tanh(t);
        d = 0.5*(1.0+th) + 0.5*v*(1.0-th*th)*k*(1.0+3.0*0.044715*v*v);
    }else if(pc.mode == 1u){
        float s = 1.0 / (1.0 + exp(-v));
        d = s*(1.0-s);
    }else{
        float s = 1.0 / (1.0 + exp(-v));
        d = s*(1.0 + v*(1.0-s));
    }
    gx[i] += go[i] * d;
}
