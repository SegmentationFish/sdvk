// dst[i*d+j] = src[idx[i]*d + j]
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer SRC { float src[]; };
layout(binding = 1) readonly buffer IDX { uint idx[]; };
layout(binding = 2) writeonly buffer DST { float dst[]; };
layout(push_constant) uniform PC { uint n; uint d; } pc;

void main(){
    uint i = gl_GlobalInvocationID.x;
    if(i >= pc.n * pc.d) return;
    uint r = i / pc.d;
    uint j = i % pc.d;
    dst[i] = src[idx[r]*pc.d + j];
}
