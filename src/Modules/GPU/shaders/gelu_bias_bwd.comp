// dpre = dy * gelu'(pre); db[c] += sum_r dpre[r,c]. One workgroup handles a column.
layout(local_size_x = 256) in;
layout(binding = 0) buffer DY { float dy[]; };
layout(binding = 1) readonly buffer PRE { float pre[]; };
layout(binding = 2) buffer DB { float db[]; };
layout(push_constant) uniform PC { uint rows; uint cols; } pc;

shared float red[256];

void main(){
    uint c = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (c >= pc.cols) return;
    const float k = 0.7978845608028654;
    float s = 0.0;
    for (uint r = tid; r < pc.rows; r += 256){
        uint i = r * pc.cols + c;
        float v = pre[i];
        float t = k * (v + 0.044715 * v * v * v);
        float th = tanh(t);
        float d = 0.5 * (1.0 + th) + 0.5 * v * (1.0 - th * th) * k * (1.0 + 3.0 * 0.044715 * v * v);
        float g = dy[i] * d;
        dy[i] = g;
        s += g;
    }
    red[tid] = s;
    barrier();
    for (uint step = 128; step > 0; step >>= 1){
        if (tid < step) red[tid] += red[tid + step];
        barrier();
    }
    if (tid == 0) db[c] += red[0];
}
