// C[M,N] = A[M,K] * B[K,N] ; A = Q8_0 payload (uint32 packed int8, 4/word) + fp32 scales
// (one per 32 elements), B fp32 row-major. Batched on z.
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0) readonly buffer Aq { uint aq[]; };
layout(binding = 1) readonly buffer B { float b[]; };
layout(binding = 2) writeonly buffer C { float c[]; };
layout(binding = 3) readonly buffer S { float s[]; };
layout(push_constant) uniform PC { uint M; uint N; uint K; uint mode;
                                  uint sA; uint sB; uint sC; uint batch;
                                  uint lda; uint ldb; uint ldc; uint pad; } pc;

#ifndef QBM
#define QBM 64
#endif
const uint BM = QBM, BN = 64, BK = 16, TM = QBM / 16, TN = 4;
shared float As[BM][BK + 1];
shared float Bs[BK][BN + 1];

float deqA(uint fl){
    uint w = aq[fl >> 2];
    int v = int((w >> ((fl & 3u) * 8u)) & 0xFFu);
    if (v > 127) v -= 256;
    return float(v) * s[fl >> 5];
}

void main(){
    uint tx = gl_LocalInvocationID.x;
    uint ty = gl_LocalInvocationID.y;
    uint by = gl_WorkGroupID.y;
    uint bx = gl_WorkGroupID.x;
    uint zo = gl_WorkGroupID.z;
    uint ao = zo * pc.sA;
    uint bo = zo * pc.sB;
    uint co = zo * pc.sC;
    uint lda = pc.lda == 0u ? pc.K : pc.lda;
    uint ldb = pc.ldb == 0u ? pc.N : pc.ldb;
    uint ldc = pc.ldc == 0u ? pc.N : pc.ldc;

    float acc[TM][TN];
    for(uint i=0;i<TM;i++)
        for(uint j=0;j<TN;j++) acc[i][j]=0.0;

    uint nTiles = (pc.K + BK - 1) / BK;
    for(uint t=0;t<nTiles;t++){
        uint kBase = t * BK;
        // A (q8): one packed word per iteration, four values share one fp32 scale
        for (uint e = ty*16u + tx; e < (BM*BK)/4u; e += 256u) {
            uint r = (e*4u) / BK;
            uint c = (e*4u) % BK;
            uint gr = by*BM + r;
            uint gc = kBase + c;
            if (gr < pc.M && gc + 3u < pc.K) {
                uint fl = ao + gr*lda + gc;
                uint w = aq[fl >> 2];
                float sc = s[fl >> 5];
                int v0 = int(w & 0xFFu); if (v0 > 127) v0 -= 256;
                int v1 = int((w >> 8u) & 0xFFu); if (v1 > 127) v1 -= 256;
                int v2 = int((w >> 16u) & 0xFFu); if (v2 > 127) v2 -= 256;
                int v3 = int((w >> 24u) & 0xFFu); if (v3 > 127) v3 -= 256;
                As[r][c + 0u] = float(v0) * sc;
                As[r][c + 1u] = float(v1) * sc;
                As[r][c + 2u] = float(v2) * sc;
                As[r][c + 3u] = float(v3) * sc;
            } else {
                As[r][c + 0u] = 0.0; As[r][c + 1u] = 0.0;
                As[r][c + 2u] = 0.0; As[r][c + 3u] = 0.0;
            }
        }
        // B (fp32): 16-byte coalesced loads
        for (uint e = ty*16u + tx; e < (BK*BN)/4u; e += 256u) {
            uint r = (e*4u) / BN;
            uint c = (e*4u) % BN;
            uint gr = kBase + r;
            uint gc = bx*BN + c;
            if (gr < pc.K && gc + 3u < pc.N) {
                uint g = bo + gr*ldb + gc;
                Bs[r][c + 0u] = b[g + 0u];
                Bs[r][c + 1u] = b[g + 1u];
                Bs[r][c + 2u] = b[g + 2u];
                Bs[r][c + 3u] = b[g + 3u];
            } else {
                Bs[r][c + 0u] = 0.0; Bs[r][c + 1u] = 0.0;
                Bs[r][c + 2u] = 0.0; Bs[r][c + 3u] = 0.0;
            }
        }
        barrier();
        for(uint k=0;k<BK;k++){
            float av[TM];
            float bv[TN];
            for(uint i=0;i<TM;i++) av[i]=As[ty*TM+i][k];
            for(uint j=0;j<TN;j++) bv[j]=Bs[k][tx*TN+j];
            for(uint i=0;i<TM;i++)
                for(uint j=0;j<TN;j++) acc[i][j]+=av[i]*bv[j];
        }
        barrier();
    }
    for(uint i=0;i<TM;i++)
        for(uint j=0;j<TN;j++){
            uint gr = by*BM + ty*TM + i;
            uint gc = bx*BN + tx*TN + j;
            if(gr < pc.M && gc < pc.N){
                if(pc.mode == 0u) c[co + gr*ldc + gc] = acc[i][j];
                else c[co + gr*ldc + gc] += acc[i][j];
            }
        }
}
