#version 450
// 2D transpose: in[rows,cols] -> out[cols,rows] (f32, row-major). 用于 MoE 稠密路径
// 的权重列视图（sparse[rows,G] -> wT[G,rows]，每专家一行连续）。
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 1) writeonly buffer Y { float y[]; };
layout(push_constant) uniform PC { uint rows; uint cols; } pc;

void main(){
    uint i = gl_GlobalInvocationID.x;
    uint n = pc.rows * pc.cols;
    if (i >= n) return;
    uint r = i / pc.cols;
    uint c = i % pc.cols;
    y[c * pc.rows + r] = x[i];
}
