#version 450
// out[0] = s * sum_i x[i]   (single workgroup)
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 1) writeonly buffer OUT { float outv[]; };
layout(push_constant) uniform PC { uint n; float s; } pc;

shared float red[256];

void main(){
    uint tid = gl_LocalInvocationID.x;
    float acc = 0.0;
    for(uint i=tid;i<pc.n;i+=256) acc += x[i];
    red[tid] = acc;
    barrier();
    for(uint step=128;step>0;step>>=1){
        if(tid < step) red[tid] += red[tid+step];
        barrier();
    }
    if(tid == 0) outv[0] += pc.s * red[0];   // accumulate (outputs start zeroed)
}
