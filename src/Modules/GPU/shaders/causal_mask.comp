#version 450
// causal mask on attention scores [batch, rows, cols]: s[r,c] = -inf if c > r
layout(local_size_x = 256) in;
layout(binding = 0) buffer S { float s[]; };
layout(push_constant) uniform PC { uint batch; uint rows; uint cols; } pc;

void main(){
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.batch * pc.rows * pc.cols) return;
    uint r = (i / pc.cols) % pc.rows;
    uint c = i % pc.cols;
    if (c > r) s[i] = -3.0e38;
}
